{
	"name": "pi-cc-compaction",
	"version": "0.2.8",
	"description": "Claude Code's compaction for the Pi coding agent: summaries that reuse the prompt cache, Claude Code's thresholds and prompt, and idle compaction before the cache expires.",
	"author": "tarnish233",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"extension",
		"claude-code",
		"compaction",
		"context",
		"prompt-cache"
	],
	"homepage": "https://github.com/tarnish233/pi-cc-compaction#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tarnish233/pi-cc-compaction.git"
	},
	"bugs": {
		"url": "https://github.com/tarnish233/pi-cc-compaction/issues"
	},
	"files": [
		"*.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
